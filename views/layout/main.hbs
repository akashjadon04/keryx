<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Keryx Application page; The Ultimate Email API for Developers" />
    <title>Keryx</title>

    {{> head_assets}}

    <link href="/static/css/flyonui.css" rel="stylesheet">
    <link href="/static/css/liquid-glass.css" rel="stylesheet">

</head>

<body class="bg-base-200 flex min-h-full flex-col">
    <main role="main" class="shrink-0 grow">

        <div class="container mx-auto px-4 mt-6">
            <div class="flex items-center gap-3">
                <img src="/static/logo/keryx_logo_horiz.svg" class="block h-10 w-auto max-w-full" alt="Keryx">
            </div>

            <div class="mt-6 max-w-3xl">
                {{> alerts}}
            </div>

            {{{content}}}


        </div>
    </main>

    <footer class="mt-auto py-4">
        <div class="container mx-auto px-4">
            <div>
                Keryx
                <span class="text-base-content/60">&copy; 2020-{{currentYear}}</span>
                &middot; Engineered &amp; Crafted by <a href="https://akashworks.online" target="_blank" rel="noopener noreferrer" class="font-bold text-primary hover:underline">Akash Jadon</a>
                &middot; <a href="https://akashworks.online" target="_blank" rel="noopener noreferrer" class="opacity-75 hover:opacity-100 font-mono">akashworks.online</a>
                {{!-- version marker only: the license key must not appear in
                      page source - this layout serves unauthenticated pages --}}
                <!-- v{{packageData.version}} -->
            </div>
        </div>
    </footer>

    <script data-cfasync="false" src="/static/js/flyonui.js"></script>
    <script data-cfasync="false" src="/static/js/ui.js"></script>
</body>

</html>
